{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend (FastAPI + SQLite)",
      "type": "shell",
      "command": "C:/Users/HP/anaconda3/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend"
        }
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "2. Start Web Client (Port 3000)",
      "type": "shell",
      "command": "C:/Users/HP/anaconda3/python.exe",
      "args": [
        "-m",
        "http.server",
        "3000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "3. Start Expo Mobile App",
      "type": "shell",
      "command": "npx",
      "args": [
        "expo",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/mobile"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "mobile"
      }
    },
    {
      "label": "4. Run All Test Suites",
      "type": "shell",
      "command": "node",
      "args": [
        "scratch/test_full_app_e2e.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "5. Run Backend (via run_backend.py)",
      "type": "shell",
      "command": "C:/Users/HP/anaconda3/python.exe",
      "args": [
        "run_backend.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
