# NutriBite AI - Environment Configuration
APP_NAME=NutriBite AI
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (Defaults to SQLite for local development; supports PostgreSQL)
# For SQLite: sqlite:///./nutribite.db
# For PostgreSQL: postgresql://username:password@localhost:5432/nutribite_db
DATABASE_URL=sqlite:///./nutribite.db

# Authentication Security
SECRET_KEY=nutribite-super-secure-production-jwt-key-2026-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# USDA FoodData Central API (Get free key at https://fdc.nal.usda.gov/api-key-signup.html)
USDA_FDC_API_KEY=DEMO_KEY

# AI / LLM Configuration for Nutrition Assistant (OpenAI, Gemini, or Claude)
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8000
